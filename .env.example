# Copy to .env and fill in. .env is git-ignored — never commit real keys.
ANTHROPIC_API_KEY=

# Optional: which model to use, as provider/model (default: claude-sonnet-5-5, whose provider
# is anthropic). For a model on this machine through Ollama: ollama/gemma4:12b-it-q4_K_M.
VARDEX_MODEL=

# Optional: a smaller model to try first; VARDEX_MODEL answers only when its answer fails a
# check. And a candidate that answers beside VARDEX_MODEL in shadow, shown to nobody.
VARDEX_SMALL_MODEL=
VARDEX_SHADOW_MODEL=

# For the openai provider: any OpenAI-compatible server (vLLM, LM Studio, a hosted provider
# of open-weight models), or OpenAI itself when the address is left out. A local server that
# checks no key takes any value.
OPENAI_BASE_URL=
OPENAI_API_KEY=

# For the ollama provider, when Ollama is not at its usual 127.0.0.1:11434
OLLAMA_HOST=

# Optional: what an hour of the machine that runs a local model costs, in dollars, so its
# answers have a cost too. Unset, a local model's answers cost nothing.
VARDEX_PRICE_PER_HOUR=

# Optional: a model to send a call to when VARDEX_MODEL's provider cannot be reached
VARDEX_FALLBACK_MODEL=

# Optional: where fetched files and warehouses are kept (default: data)
VARDEX_DATA_DIR=

# Optional: a warehouse someone else runs, instead of the pack's own DuckDB file, such as
# postgresql://vardex_reader@localhost:5432/vardex. Use an account that may only read, and
# give its password in PGPASSWORD, never in the URL.
VARDEX_WAREHOUSE_URL=
PGPASSWORD=

# The index of a pack's documents: a PostgreSQL database with pgvector, which Vardex writes to,
# such as postgresql://postgres@localhost:5433/vardex. Give a password in ~/.pgpass, never here.
VARDEX_INDEX_URL=

# Optional: the open-weight models that search runs on this machine (defaults:
# intfloat/multilingual-e5-large and BAAI/bge-reranker-v2-m3; none turns reranking off)
VARDEX_EMBEDDING_MODEL=
VARDEX_RERANK_MODEL=

# Optional: send traces to a backend over OTLP, as well as to the local files in
# data/<pack>/traces. These are OpenTelemetry's own variables. For Langfuse Cloud (EU), the
# header is your project's public and secret key, joined by a colon and base64-encoded:
#   printf 'pk-lf-…:sk-lf-…' | base64
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Optional: read traces back from Langfuse instead of the local files (VARDEX_TRACE_STORE=langfuse),
# with the project's keys. LANGFUSE_HOST defaults to https://cloud.langfuse.com (EU).
VARDEX_TRACE_STORE=
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Optional: where what people asked and what the model wrote may go. local (default): the
# local trace files only. all: the backend too. none: nowhere.
VARDEX_TRACE_CONTENT=

# Pack-specific keys go below. The norwegian-companies pack needs none:
# the Brønnøysund registers and SSB's APIs are open.

# The folder the notes MCP server in packs/norwegian-companies/mcp.yaml searches
VARDEX_NOTES_DIR=
