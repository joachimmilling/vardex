# Copy to .env and fill in. .env is git-ignored — never commit real keys.
ANTHROPIC_API_KEY=

# Optional: which Claude model to use (default: claude-sonnet-5-5)
VARDEX_MODEL=

# Optional: where fetched files and warehouses are kept (default: data)
VARDEX_DATA_DIR=

# Optional: a warehouse someone else runs, instead of the pack's own DuckDB file, such as
# postgresql://vardex_reader@localhost:5432/vardex. Use an account that may only read, and
# give its password in PGPASSWORD, never in the URL.
VARDEX_WAREHOUSE_URL=
PGPASSWORD=

# The index of a pack's documents: a PostgreSQL database with pgvector, which Vardex writes to,
# such as postgresql://postgres@localhost:5433/vardex. Give a password in ~/.pgpass, never here.
VARDEX_INDEX_URL=

# Optional: the open-weight models that search runs on this machine (defaults:
# intfloat/multilingual-e5-large and BAAI/bge-reranker-v2-m3; none turns reranking off)
VARDEX_EMBEDDING_MODEL=
VARDEX_RERANK_MODEL=

# Pack-specific keys go below. The norwegian-companies pack needs none:
# the Brønnøysund registers and SSB's APIs are open.
